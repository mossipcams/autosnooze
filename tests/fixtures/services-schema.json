          }
        }
      }
    },
    "cancel_scheduled": {
      "name": "Cancel Scheduled Snooze",
      "fields": {
        "entity_id": {
          "required": true,
          "selector": {
            "entity": {
              "domain": ["automation", "input_boolean"],
              "multiple": true
            }
          }
        }
      }
    },
    "adjust": {
      "name": "Adjust Snooze",
      "fields": {
        "entity_id": {
          "required": true,
          "selector": {
            "entity": {
              "domain": ["automation", "input_boolean"],
              "multiple": true
            }
          }
        },
        "days": {
          "required": false,
          "default": 0,
          "selector": {
            "number": {
              "min": -365,
              "max": 365
            }
          }
        },
        "hours": {
          "required": false,
          "default": 0,
          "selector": {
            "number": {
              "min": -23,
              "max": 23
            }
          }
        },
        "minutes": {
          "required": false,
          "default": 0,
          "selector": {
            "number": {
              "min": -59,
              "max": 59
            }
          }
        }
      }
    },
    "report_telemetry": {
      "name": "Report Telemetry",
      "fields": {
        "event": {
          "required": true,
          "selector": {
            "text": {}
          }
        },
        "properties": {
          "required": false,
          "selector": {
            "object": {}
          }
        },
        "source": {
          "required": false,
          "default": "card",
          "selector": {
            "text": {}
          }
        },
        "card_type": {
          "required": false,
          "selector": {
            "select": {
              "options": [
                { "label": "Full card", "value": "full" },
                { "label": "Snoozed-only card", "value": "snoozed_only" }
              ]
            }
          }
        },
        "platform": {
          "required": false,
          "selector": {
            "select": {
              "options": [
                { "label": "Web", "value": "web" },
                { "label": "Mobile", "value": "mobile" },
                { "label": "Tablet", "value": "tablet" }
              ]
            }
          }
        }
      }
    }
  },
  "translation_keys": [
    "not_automation",
    "resume_time_past",
    "disable_after_resume",
    "invalid_duration",
    "invalid_adjustment",
    "adjust_time_too_short",
    "save_failed",
    "pause_failed",
    "wake_failed",
    "adjust_failed",
    "confirm_required",
    "notification_lead_too_long",
    "invalid_resume_preset",
    "invalid_previous_state"
  ]
}
